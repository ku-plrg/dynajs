{
  "name": "dynajs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "dynajs": "./dynajs",
    "dynajs-clean": "./dynajs-clean",
    "dynajs-inject": "./dynajs-inject"
  },
  "scripts": {
    "clean": "npm-run-all clean:analyses clean:dynajs",
    "clean:analyses": "rimraf ./analyses/dist",
    "clean:dynajs": "rimraf ./dist",
    "build": "tsc -b && npm run typecheck:analyses && npm run build:entry && npm run build:analysis",
    "typecheck:analyses": "tsc -p ./analyses/tsconfig.json",
    "build:analysis": "node ./scripts/build-analysis.mjs",
    "build:entry": "node ./scripts/build-entry.mjs",
    "build:watch": "tsc -b -w",
    "start": "ts-node src",
    "start:watch": "nodemon src --watch src --watch samples -e ts,js --exec 'ts-node'",
    "sunspider": "npm run build && ./bench/run-sunspider-benchmark.sh",
    "format": "prettier --write . | grep -v '(unchanged)$'",
    "test": "",
    "test:watch": "",
    "test:taint": "npm run build && node ./scripts/run-taint-tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ku-plrg/dynajs.git"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ku-plrg/dynajs/issues"
  },
  "homepage": "https://github.com/ku-plrg/dynajs#readme",
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.1",
    "@types/object-inspect": "^1.13.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.4",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "chalk": "^5.6.2",
    "dedent-js": "^1.0.1",
    "yargs": "^17.7.2"
  }
}
