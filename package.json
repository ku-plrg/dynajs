{
  "name": "dynajs",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": {
    "dynajs": "./bin/dynajs",
    "djx": "./bin/djx"
  },
  "scripts": {
    "build": "run-p typecheck typecheck:example-simple typecheck:example-shadow build:entry build:analysis",
    "copy": "node ./scripts/copy-polyfill.mjs",
    "clean": "rimraf ./examples/dist ./dist ./tsconfig.tsbuildinfo",
    "doctor": "node ./scripts/doctor.mjs",
    "typecheck": "tsc -b",
    "typecheck:example-shadow": "tsc -p ./examples/tsconfig.json",
    "typecheck:example-simple": "tsc -p ./examples/simple/tsconfig.json",
    "typecheck:include-nocheck": "node ./scripts/typecheck-full.mjs",
    "build:analysis": "node ./scripts/build-analysis.mjs",
    "build:entry": "node ./scripts/build-entry.mjs",
    "build:watch": "tsc -b -w",
    "sunspider": "npm run build && ./bench/run-sunspider-benchmark.sh",
    "microbench": "echo 'run `npm run microbench:taint` or `npm run microbench:concolic` to run the micro benchmark'",
    "microbench:taint": "npm run build && node ./bench/run-micro-benchmark.mjs --done",
    "microbench:concolic": "npm run build && node ./bench/run-micro-benchmark.mjs --replay",
    "microbench:done": "npm run build && node ./bench/run-micro-benchmark.mjs --done",
    "microbench:check": "npm run build && node ./bench/run-micro-benchmark.mjs --check",
    "microbench:snapshot": "npm run build && node ./bench/run-micro-benchmark.mjs --update-snapshot",
    "microbench:count": "node ./bench/run-micro-benchmark.mjs --count",
    "microbench:count:done": "node ./bench/run-micro-benchmark.mjs --count --done",
    "microbench:done:coverage": "node ./bench/run-micro-benchmark.mjs --coverage",
    "microbench:stat": "node ./bench/micro-composition.mjs",
    "check": "biome check . --write",
    "loc": "node ./scripts/loc.mjs",
    "spec-coverage": "node ./scripts/spec-coverage.mjs",
    "check:partial": "node ./tools/partial-check/run.mjs",
    "check:partial:test": "node ./tools/partial-check/run.mjs --test",
    "check:partial:gen": "node ./tools/partial-check/run.mjs --gen",
    "check:partial:emit": "node ./tools/partial-check/run.mjs --emit",
    "pretest": "npm run build",
    "test": "node ./scripts/run-tests.mjs",
    "test:watch": "npm run test -- --watch",
    "test:update": "npm run test -- --update",
    "test:taint": "npm run build && node --test tests/analyses/taint.test.mjs",
    "test:concolic": "npm run build && node --test tests/analyses/concolic.test.mjs",
    "test262:extract": "npm run build && node ./bench/test262/extract.cjs",
    "test262:run": "npm run build && node ./bench/test262/run.cjs",
    "test262:run-node": "npm run build && npm run test262:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ku-plrg/dynajs.git"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ku-plrg/dynajs/issues"
  },
  "homepage": "https://github.com/ku-plrg/dynajs#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.1",
    "@types/object-inspect": "^1.13.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.4",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "chalk": "^5.6.2",
    "yargs": "^17.7.2"
  }
}
