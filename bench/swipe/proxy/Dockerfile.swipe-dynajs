# SWIPE image + Node 20 for the DynaJS instrument server (the base image ships Node 10).
FROM swipe:latest
USER root
RUN curl -fsSL https://nodejs.org/dist/v20.18.0/node-v20.18.0-linux-x64.tar.xz -o /tmp/node.tar.xz \
 && mkdir -p /opt/node20 && tar -xJf /tmp/node.tar.xz -C /opt/node20 --strip-components=1 && rm /tmp/node.tar.xz
USER scan
