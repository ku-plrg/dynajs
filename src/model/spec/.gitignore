# Everything under src/model/spec/ is regenerated by `npm run copy` and ignored
# by default, so `git status` stays free of generated noise. Hand-authored
# implementations are named `*.manual.ts` and tracked normally; `npm run copy`
# emits a thin generated `*.ts` shim next to each that re-exports it, so other
# spec files keep importing `./AO__Foo.js` regardless of who authored it.
*
!.gitignore
!*.manual.ts
